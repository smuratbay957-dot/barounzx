[Unit]
Description=Barounzx Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP_DIR__/bot
Environment=PYTHONUNBUFFERED=1
ExecStart=__APP_DIR__/bot/.venv/bin/python __APP_DIR__/bot/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
